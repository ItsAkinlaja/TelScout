APP_NAME=TelScout
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telscout
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# Shared hosting: set to "database". Use Redis only if your host provides it.
# DB queue processes every 5 minutes via schedule:run cron.

FILESYSTEM_DISK=local

FRONTEND_URL=http://localhost:5173

# ── Job source API keys (server-wide, optional) ──────────────────
# Adzuna (free tier) — https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# The Muse (optional key) — https://www.themuse.com/developers/api/v2
THE_MUSE_API_KEY=

# JSearch via RapidAPI (200 req/month free) — aggregates Indeed, Glassdoor, LinkedIn
# Register at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Reed.co.uk (free API key) — UK's largest job board with international postings
# Register at https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# ── Nigerian & African job sources ───────────────────────────────────
# IndeedNigeria — no key needed (ng.indeed.com JSON endpoint, runs automatically)
# AfricaWork    — no key needed (africa-work.com public feed, runs automatically)

# SerpAPI — Google Jobs aggregator (RECOMMENDED for Nigerian jobs)
# A single key surfaces Jobberman, LinkedIn Nigeria, Indeed NG, MyJobMag, and more.
# Free tier: 100 searches/month (no credit card). Register at https://serpapi.com
SERPAPI_KEY=

# Everything else (Gmail OAuth, AI, Hunter.io, Apollo.io, send limits, preferences)
# is configured per-user inside the app at Settings → Automation / Gmail / Preferences

# ── Social Login (Google Sign-In for the login page) ──────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Magic Link / Email login ───────────────────────────────────────
# Set MAIL_* vars to enable real email delivery. Until then, links are logged to storage/logs.
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@telscout.com"
MAIL_FROM_NAME="TelScout"
