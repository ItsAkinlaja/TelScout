APP_NAME=TelScout
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telscout
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# Shared hosting: set to "database". Use Redis only if your host provides it.
# DB queue processes every 5 minutes via schedule:run cron.

FILESYSTEM_DISK=local

FRONTEND_URL=http://localhost:5173

# ── Optional job source API keys ─────────────────────────────────
# Adzuna (free tier) — https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# The Muse (optional key) — https://www.themuse.com/developers/api/v2
THE_MUSE_API_KEY=


# Everything else (Gmail OAuth, AI API key, send limits, preferences)
# is configured inside the app at Settings → Gmail / Automation / Preferences
